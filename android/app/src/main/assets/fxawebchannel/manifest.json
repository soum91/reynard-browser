{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "fxawebchannel@reynardtv.test"
    }
  },
  "name": "Reynard TV Mozilla Account WebChannel (test)",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://accounts.firefox.com/*"],
      "js": ["fxawebchannel.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "https://accounts.firefox.com/*"
  ]
}
